@model ClockViewModel

@{
    var color = ViewBag.Color ?? "black";
    var displayColor = color == "white" ? "White" : "Black";
}

<div class="card-body text-center"
     id="clock-@color"
     data-minutes="@Model.Minutes"
     data-increment="@Model.Increment">
    <div class="d-flex justify-content-between align-items-center mb-2">
        <small class="text-uppercase text-muted fw-bold">@displayColor</small>
        <span class="badge bg-success rounded-circle" style="width: 10px; height: 10px;"></span>
    </div>
    <h3 id="clock-value-@color" class="mb-0 text-info fw-bold" style="font-family: monospace;">
        @Model.Minutes.ToString("00"):00
    </h3>
</div>

<style>
    .card-body {
        background-color: var(--bg-card);
        border: 2px solid var(--border-color);
        border-radius: 1rem;
        padding: 1rem 1.5rem;
        min-width: 180px;
        transition: all 0.3s ease;
        box-shadow: 0 4px 15px rgba(0, 0, 0, 0.3);
    }
    
    .card-body:hover {
        border-color: var(--accent-primary);
        box-shadow: 0 6px 20px rgba(0, 212, 255, 0.2);
    }
    
    .text-uppercase {
        text-transform: uppercase !important;
    }
    
    .fw-bold {
        font-weight: 700 !important;
    }
    
    .rounded-circle {
        border-radius: 50% !important;
    }
</style>
