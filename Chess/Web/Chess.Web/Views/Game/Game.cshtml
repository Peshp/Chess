@model BoardViewModel

@{
    ViewData["Title"] = "Chess Game";
}

<link rel="stylesheet" href="~/css/game.css" />

<div class="game-page">
    <div class="container-fluid py-4">
        <div class="row justify-content-center g-4">
            
            <div class="col-12 col-lg-auto">
                <div class="d-flex flex-column gap-3">
                    <!-- Black Clock -->
                    <div class="card bg-dark border-secondary shadow-sm">
                        @await Html.PartialAsync("_ClockPartial", Model.BlackClock,
                            new ViewDataDictionary(ViewData) { { "Color", "black" } })
                    </div>

                    @await Html.PartialAsync("_GamePartial", Model)

                    <div class="card bg-dark border-secondary shadow-sm">
                        @await Html.PartialAsync("_ClockPartial", Model.WhiteClock,
                            new ViewDataDictionary(ViewData) { { "Color", "white" } })
                    </div>
                </div>
            </div>

            <div class="col-12 col-lg-auto">
                <div class="d-flex flex-column gap-3" style="min-width: 300px; max-width: 350px;">
                    
                    <div class="card bg-dark border-secondary shadow-sm">
                        <div class="card-body py-2">
                            <h6 class="mb-0 text-white">
                                <i class="bi bi-controller me-2 text-info"></i>
                                Game Information
                            </h6>
                        </div>
                    </div>

                    <div class="card bg-dark border-secondary shadow-sm">
                        <div class="card-header bg-black border-bottom border-secondary py-2">
                            <h6 class="mb-0 text-white-50">
                                <i class="bi bi-trophy me-2"></i>Captured Pieces
                            </h6>
                        </div>
                        <div class="card-body" style="background: rgba(148, 163, 184, 0.08); min-height: 120px;">
                            <div id="captured-pieces" class="d-flex flex-wrap gap-2 justify-content-center">
                                @if (Model.CapturedFigures != null && Model.CapturedFigures.Any())
                                {
                                    @foreach (var figure in Model.CapturedFigures)
                                    {
                                        <div class="captured-piece-box">
                                            <img src="~/images/pieces/@figure.Image"
                                                 alt="@figure.Name"
                                                 class="captured-piece-img"
                                                 title="@figure.Color @figure.Name" />
                                        </div>
                                    }
                                }
                                else
                                {
                                    <div class="text-muted text-center py-3 w-100">
                                        <i class="bi bi-inbox fs-2 d-block mb-2 opacity-25"></i>
                                        <small>No captures yet</small>
                                    </div>
                                }
                            </div>
                        </div>
                    </div>

                    @await Html.PartialAsync("_MoveHistoryPanel", Model)

                    <!-- Game Actions -->
                    <div class="card bg-dark border-secondary shadow-sm">
                        <div class="card-header bg-black border-bottom border-secondary py-2">
                            <h6 class="mb-0 text-white-50">
                                <i class="bi bi-gear me-2"></i>Game Actions
                            </h6>
                        </div>
                        <div class="card-body">
                            <div class="d-grid gap-2">
                                <form asp-controller="Game" asp-action="EndGame" method="get">
                                    <button type="submit"
                                            class="btn btn-outline-danger w-100"
                                            onclick="return confirm('Are you sure you want to surrender? You will lose this game.');">
                                        <i class="bi bi-flag-fill me-2"></i>Surrender
                                    </button>
                                </form>

                                <form asp-controller="Game" asp-action="EndGame" method="get">
                                    <button type="submit"
                                            class="btn btn-outline-info w-100"
                                            onclick="return confirm('Do you want to offer a draw?');">
                                        <i class="bi bi-handshake me-2"></i>Offer Draw
                                    </button>
                                </form>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<div id="promotionModal" class="promotion-modal">
    <div class="promotion-modal-content">
        <h2 class="promotion-title">
            <i class="bi bi-trophy-fill me-2"></i>Promote Pawn
        </h2>
        <div class="promotion-options" id="promotionOptions">
        </div>
    </div>
</div>

<script src="~/js/game.js"></script>
