@model ClockViewModel

@{
    ViewBag.Model = "Chess Arena";
}

<link rel="stylesheet" href="~/css/index.css" />

<div class="chess-arena">
    <div class="container-fluid">
        <div class="row min-vh-100 align-items-center justify-content-center">

            <!-- Hero Section -->
            <div class="col-lg-5 hero-content">
                <div class="fade-in-up">
                    <div class="badge-wrapper mb-4">
                        <span class="status-badge">
                            <span class="pulse-dot"></span>
                            LIVE V2.0
                        </span>
                    </div>
                    
                    <h1 class="hero-title mb-4">
                        <span class="primary-text">CHESS</span>
                        <span class="gradient-text">ARENA</span>
                    </h1>
                    
                    <p class="hero-description mb-5">
                        Enter the ultimate battleground where strategy meets elegance. 
                        Challenge grandmaster AI, compete globally, and master the timeless game.
                    </p>
                    
                    <div class="stats-container">
                        <div class="stat-card">
                            <div class="stat-value">2.4K+</div>
                            <div class="stat-label">Players Online</div>
                        </div>
                        <div class="stat-divider"></div>
                        <div class="stat-card">
                            <div class="stat-value">SF16</div>
                            <div class="stat-label">Stockfish Engine</div>
                        </div>
                        <div class="stat-divider"></div>
                        <div class="stat-card">
                            <div class="stat-value">98%</div>
                            <div class="stat-label">Accuracy</div>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Action Tiles -->
            <div class="col-lg-6 offset-lg-1">
                <div class="tiles-grid fade-in-up delay-1">
                    
                    <!-- Quick Match -->
                    <div class="game-tile featured-tile" data-bs-toggle="modal" data-bs-target="#quickMatchModal">
                        <div class="tile-glow"></div>
                        <div class="tile-content">
                            <div class="tile-icon-wrapper">
                                <i class="bi bi-lightning-charge-fill"></i>
                            </div>
                            <div class="tile-info">
                                <h3 class="tile-title">Quick Match</h3>
                                <p class="tile-description">Instant ranked gameplay</p>
                            </div>
                            <div class="tile-arrow">
                                <i class="bi bi-arrow-right"></i>
                            </div>
                        </div>
                    </div>

                    <!-- AI Practice -->
                    <form asp-controller="Game" asp-action="Game" method="get" class="tile-form">
                        <input type="hidden" name="gameType" value="AI" />
                        <button type="submit" class="game-tile secondary-tile">
                            <div class="tile-content">
                                <div class="tile-icon-wrapper ai-icon">
                                    <i class="bi bi-robot"></i>
                                </div>
                                <div class="tile-info">
                                    <h4 class="tile-title">AI Practice</h4>
                                    <p class="tile-description">Train with Stockfish</p>
                                </div>
                            </div>
                        </button>
                    </form>

                    <!-- Leaderboard -->
                    <form asp-controller="User" asp-action="Profile" method="get" class="tile-form">
                        <button type="submit" class="game-tile secondary-tile">
                            <div class="tile-content">
                                <div class="tile-icon-wrapper trophy-icon">
                                    <i class="bi bi-trophy-fill"></i>
                                </div>
                                <div class="tile-info">
                                    <h4 class="tile-title">Leaderboard</h4>
                                    <p class="tile-description">Global rankings</p>
                                </div>
                            </div>
                        </button>
                    </form>

                    <!-- Profile -->
                    <form asp-controller="User" asp-action="Profile" method="get" class="tile-form">
                        <button type="submit" class="game-tile secondary-tile">
                            <div class="tile-content">
                                <div class="tile-icon-wrapper profile-icon">
                                    <i class="bi bi-person-circle"></i>
                                </div>
                                <div class="tile-info">
                                    <h4 class="tile-title">Your Profile</h4>
                                    <p class="tile-description">Stats & achievements</p>
                                </div>
                            </div>
                        </button>
                    </form>

                </div>
            </div>
        </div>
    </div>

    <!-- Animated Background -->
    <div class="chess-bg">
        <div class="chess-piece piece-1">♔</div>
        <div class="chess-piece piece-2">♛</div>
        <div class="chess-piece piece-3">♝</div>
        <div class="chess-piece piece-4">♞</div>
    </div>
</div>

<!-- Quick Match Modal -->
<div class="modal fade" id="quickMatchModal" tabindex="-1" aria-labelledby="quickMatchLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content custom-modal">
            <div class="modal-header border-0">
                <h2 class="modal-title" id="quickMatchLabel">
                    <i class="bi bi-lightning-charge-fill text-warning me-2"></i>
                    Quick Match Setup
                </h2>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body p-4">
                <form asp-controller="Game" asp-action="Game" method="get">
                    <input type="hidden" name="gameType" value="Normal" />

                    <label class="form-label text-light mb-3">Select Time Control</label>
                    <div class="time-control-grid mb-4">
                        <input type="radio" class="btn-check" name="Minutes" id="time10" value="10" checked>
                        <label class="time-option" for="time10">
                            <div class="time-value">10</div>
                            <div class="time-label">Minutes</div>
                        </label>

                        <input type="radio" class="btn-check" name="Minutes" id="time5" value="5">
                        <label class="time-option" for="time5">
                            <div class="time-value">5</div>
                            <div class="time-label">Minutes</div>
                        </label>

                        <input type="radio" class="btn-check" name="Minutes" id="time3" value="3">
                        <label class="time-option" for="time3">
                            <div class="time-value">3</div>
                            <div class="time-label">Minutes</div>
                        </label>

                        <input type="radio" class="btn-check" name="Minutes" id="time1" value="1">
                        <label class="time-option" for="time1">
                            <div class="time-value">1</div>
                            <div class="time-label">Minute</div>
                        </label>
                    </div>

                    <button type="submit" class="btn-start-match">
                        <span>Start Match</span>
                        <i class="bi bi-arrow-right-circle ms-2"></i>
                    </button>
                </form>
            </div>
        </div>
    </div>
</div>
